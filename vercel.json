{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/server.js"
    },
    {
      "src": "/app",
      "dest": "public/pages/app.html"
    },
    {
      "src": "/admin",
      "dest": "public/pages/admin.html"
    },
    {
      "src": "/reset-password.html",
      "dest": "public/pages/reset-password.html"
    },
    {
      "src": "/assets/(.*)",
      "dest": "public/assets/$1"
    },
    {
      "src": "/landing-react/(.*)",
      "dest": "public/landing-react/$1"
    },
    {
      "src": "/",
      "dest": "public/landing-react/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "src/server.js"
    }
  ]
}
