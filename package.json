{
  "name": "agente-prospeccao-real",
  "version": "25.7.0",
  "description": "SaaS de prospecção tech com landing sem scroll, analytics executivo, IA Comercial no Admin e radar no plano de ação",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:landing": "npm --prefix frontend/landing run dev",
    "build": "node scripts/build.js",
    "build:react": "npm --prefix frontend/landing run build",
    "build:static": "node scripts/sync-static-landing.js",
    "verify:landing": "node scripts/verify-landing-build.js",
    "check:syntax": "node scripts/check-all.js",
    "check:docs": "node scripts/check-documentation.js",
    "check:architecture": "node scripts/check-architecture.js",
    "check:frontend": "node scripts/check-frontend.js",
    "test": "node --test tests/*.test.js",
    "quality": "npm run check:syntax && npm run check:docs && npm run check:architecture && npm run check:frontend && npm run verify:landing && npm test",
    "check": "npm run quality"
  },
  "dependencies": {
    "@fast-csv/format": "^5.0.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.3"
  },
  "engines": {
    "node": ">=20.19 <23",
    "npm": ">=10"
  }
}
