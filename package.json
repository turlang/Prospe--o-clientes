{
  "name": "agente-prospeccao-real",
  "version": "24.1.0",
  "description": "Plataforma SaaS de prospecção comercial com landing React, CRM e automação de funil",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:landing": "vite --config frontend/landing/vite.config.mjs",
    "build": "npm run build:landing",
    "build:landing": "vite build --config frontend/landing/vite.config.mjs",
    "check": "npm run check:syntax && npm run check:docs && npm run build && npm test",
    "check:syntax": "node scripts/check-all.js",
    "check:docs": "node scripts/check-documentation.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@fast-csv/format": "^5.0.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "lucide-react": "^1.27.0"
  },
  "engines": {
    "node": ">=20.19 <23",
    "npm": ">=10"
  },
  "devDependencies": {
    "vite": "^8.1.5"
  }
}
