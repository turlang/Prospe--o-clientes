PORT=3000
NODE_ENV=development

# Produção: mantenha true para impedir fallback em JSON local.
REQUIRE_MONGODB=true
DNS_SERVERS=8.8.8.8,1.1.1.1

# Obrigatório em produção. Use uma chave longa, aleatória e exclusiva.
JWT_SECRET=troque-este-segredo-por-uma-chave-grande-e-aleatoria
JWT_EXPIRES_IN=7d

MONGODB_URI=

GOOGLE_PLACES_API_KEY=cole_sua_chave_google_places_aqui
PLACES_PROVIDER=new
ALLOW_INCOMPLETE_CONTACTS=false
AUDIT_WEBSITES=true

PUBLIC_APP_URL=http://localhost:3000
APP_NAME=LeadHunter Pro

MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_SUCCESS_URL=http://localhost:3000/app?pagamento=sucesso
MERCADO_PAGO_FAILURE_URL=http://localhost:3000/app?pagamento=falha
MERCADO_PAGO_PENDING_URL=http://localhost:3000/app?pagamento=pendente
MERCADO_PAGO_WEBHOOK_URL=http://localhost:3000/api/billing/webhook

# Segurança anti-abuso
REGISTER_IP_DAILY_LIMIT=3

# Recuperação de senha por e-mail via Resend
RESEND_API_KEY=
MAIL_FROM=LeadHunter Pro <noreply@seudominio.com>

# IA opcional para abordagem comercial personalizada
# Recomendado para camada gratuita/testes: Gemini no Google AI Studio.
# Sem chave externa o sistema usa o motor local com variações.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_APPROACH_MODEL=gpt-4o-mini
AI_APPROACHES_ENABLED=true
AI_APPROACH_TIMEOUT_MS=25000
AI_APPROACH_TEMPERATURE=0.9
AI_MAX_TOKENS=1400

# Se true, o sistema consulta os modelos disponíveis e troca automaticamente quando o modelo configurado estiver indisponível.
GEMINI_AUTO_MODEL=true
